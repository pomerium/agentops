# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.26 AS build

WORKDIR /src

COPY slackbot/go.mod slackbot/go.sum ./slackbot/
COPY harness/go.mod harness/go.sum ./harness/
RUN --mount=type=cache,target=/go/pkg/mod \
    cd slackbot && GOWORK=off go mod download

ARG TARGETOS TARGETARCH

COPY harness/api/ ./harness/api/
COPY slackbot/ ./slackbot/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd slackbot && CGO_ENABLED=0 GOWORK=off GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" \
    -o /out/slackbot ./cmd/slackbot

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/slackbot /usr/local/bin/slackbot

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/slackbot"]
