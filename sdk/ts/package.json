{
  "name": "@pomerium/agentops-harness",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the AgentOps Harness API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "buf generate",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "p-retry": "^8.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.60.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@bufbuild/buf@1.72.0": true,
    "esbuild@0.28.2": true
  }
}
