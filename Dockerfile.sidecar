# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.26 AS build

WORKDIR /src

COPY harness/go.mod harness/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    GOWORK=off go mod download

ARG TARGETOS TARGETARCH

COPY harness/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOWORK=off GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" \
    -o /out/sidecar ./cmd/sidecar

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOWORK=off GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" \
    -o /out/agent-runner ./cmd/agent-runner

RUN install -d -m 1777 /out/run/sidecar

FROM envoyproxy/envoy:distroless-v1.37.2

COPY --from=build /out/run /run
COPY --from=build /out/sidecar /usr/local/bin/sidecar
COPY --from=build /out/agent-runner /usr/local/bin/agent-runner

ENV SIDECAR_ENVOY_PATH=/usr/local/bin/envoy \
    SIDECAR_CONFIG_DIR=/run/sidecar

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/sidecar"]
CMD ["serve", "user-identity"]
